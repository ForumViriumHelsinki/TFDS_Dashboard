# Application Configuration
NODE_ENV=development
PORT=3000
VITE_APP_VERSION=0.1.0

# InfluxDB Configuration
# Note: Token should be read-only and scoped to specific buckets for security
# For development testing only
VITE_INFLUXDB_URL=https://idea-helsinki-influxdb-helm-webapp.dataportal.fi/
VITE_INFLUXDB_ORG=idea-helsinki
VITE_INFLUXDB_BUCKET=idea-fcd-bucket
# Note: InfluxDB token should be stored in Google Secret Manager for production

# Sentry Error Tracking and Performance Monitoring
# Leave empty for local development (optional)
# In production, this will be injected via GitHub Secrets and ArgoCD environment
VITE_SENTRY_DSN=
# Note: Sentry DSN is safe to expose publicly as it's designed for client-side use
# However, it's recommended to keep it in secrets for better security posture

# Sentry Auth Token (for source map uploads during build)
# This should NEVER be in VITE_ variables as it's a secret
# Only used during Docker build process via build args
# SENTRY_AUTH_TOKEN=your-sentry-auth-token-here

# Optional: Feature Flags
VITE_ENABLE_MAP_CLUSTERING=true
VITE_ENABLE_REALTIME_UPDATES=true

# ===================================
# IMPORTANT: Understanding VITE_ Prefix
# ===================================
# Vite environment variables follow this pattern:
# - VITE_* variables: Embedded into client-side bundle at BUILD TIME
#   These become PUBLIC and visible in browser JavaScript
#   Only use for non-sensitive configuration (API URLs, feature flags, etc.)
#
# - Non-prefixed variables: Server-side only, never exposed to client
#   (e.g., NODE_ENV, PORT, SENTRY_AUTH_TOKEN)
#
# ⚠️ SECURITY WARNING:
# - Never put sensitive data (API keys, tokens, database credentials) in VITE_ variables
# - For production:
#   * Sensitive API calls should be proxied through a backend service
#   * API keys and tokens should only exist server-side
#   * Use Google Secret Manager for all production secrets
#   * Consider implementing a backend API layer to protect credentials
