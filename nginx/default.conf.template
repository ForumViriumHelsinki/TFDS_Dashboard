server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Health check endpoint
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # GCS-FUSE data files — revalidate on every request to avoid stale cache
    location /data/ {
        add_header Cache-Control "no-cache" always;
    }

    # SPA routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy for HSY WFS (avoids CORS in production)
    location /hsy-wfs/ {
        proxy_pass https://kartta.hsy.fi/;
        proxy_set_header Host kartta.hsy.fi;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;

        # Cache slow WFS responses (upstream takes ~20-25s to build the grid;
        # air-quality data only updates ~hourly, so a short TTL is safe).
        # Cache zone defined at http level in 00-wfs-cache.conf.template.
        proxy_cache wfs_cache;
        proxy_cache_key $scheme$proxy_host$request_uri;  # includes query string
        proxy_cache_valid 200 10m;
        # Cache regardless of upstream cache hints. GeoServer currently sends
        # none of these, but ignoring them future-proofs the cache against an
        # upstream change. Set-Cookie is paired with proxy_hide_header below so
        # a session cookie is never stored or served to another client.
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
        # Serve last-good data while a slow refresh runs in the background, and
        # if the upstream geoserver errors out (5xx/timeout) rather than
        # blocking or failing the client.
        proxy_cache_use_stale error timeout invalid_header http_500 http_502 http_503 http_504 updating;
        proxy_cache_background_update on;
        # Finish the upstream fetch and fill the cache even if the gateway cuts
        # the client connection at 15s — the next request is then a warm HIT.
        proxy_ignore_client_abort on;

        # Strip the upstream geoserver's duplicate security headers; the
        # server-block copies are re-added below. (add_header in this location
        # suppresses inheritance of the server-block add_headers, so they must
        # be repeated here alongside the X-Cache-Status debug header.)
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        # Never cache/forward a GeoServer session cookie (e.g. JSESSIONID) — it
        # would otherwise be stored once and served to all clients.
        proxy_hide_header Set-Cookie;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    # Reverse proxy for Helsinki WFS (avoids CORS in production)
    location /hel-wfs/ {
        proxy_pass https://kartta.hel.fi/;
        proxy_set_header Host kartta.hel.fi;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;

        # Cache slow WFS responses (see /hsy-wfs/ above for rationale).
        # Cache zone defined at http level in 00-wfs-cache.conf.template.
        proxy_cache wfs_cache;
        proxy_cache_key $scheme$proxy_host$request_uri;  # includes query string
        proxy_cache_valid 200 10m;
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
        proxy_cache_use_stale error timeout invalid_header http_500 http_502 http_503 http_504 updating;
        proxy_cache_background_update on;
        proxy_ignore_client_abort on;

        # Strip the upstream's duplicate security headers; re-add the
        # server-block copies (see /hsy-wfs/ above for why they are repeated).
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        # Never cache/forward an upstream session cookie (see /hsy-wfs/ above).
        proxy_hide_header Set-Cookie;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    # Reverse proxy for InfluxDB (hides token server-side)
    # Note: We use static URLs (substituted by envsubst at startup) rather than NGINX
    # variables with a resolver directive. This ensures DNS resolution happens at config
    # load time using the pod's /etc/resolv.conf, avoiding the need for cluster-specific
    # DNS resolver IPs that vary between Kubernetes distributions.
    location /influxdb-api/ {
        rewrite ^/influxdb-api/(.*)$ /$1 break;

        # Proxy to InfluxDB with authentication
        # Use http:// for internal K8s services (HTTPS terminated at the gateway)
        proxy_pass ${INFLUXDB_URL};
        proxy_set_header Host ${INFLUXDB_HOST};
        proxy_set_header Authorization "Token ${INFLUXDB_TOKEN}";

        # Timeouts for potentially long-running queries
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Don't cache InfluxDB queries
        proxy_buffering off;
        proxy_cache_bypass 1;
        proxy_no_cache 1;
    }

    # GO Feature Flag relay proxy
    # Uses variable-based proxy_pass with resolver to defer DNS resolution to request
    # time. This prevents NGINX from failing to start when the GoFeatureFlag service
    # is unavailable. NGINX_LOCAL_RESOLVERS is exported by 15-local-resolvers.envsh.
    location /feature-flags/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
        set $goff_upstream "${GOFF_URL}";
        rewrite ^/feature-flags/(.*)$ /$1 break;
        proxy_pass $goff_upstream;
        proxy_set_header Host ${GOFF_HOST};
        include /etc/nginx/conf.d/goff-auth-header.inc;
        proxy_connect_timeout 3s;
        proxy_read_timeout 60s;
        proxy_cache off;
        add_header Cache-Control "no-cache, no-store" always;

        # WebSocket support for flag change notifications
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
