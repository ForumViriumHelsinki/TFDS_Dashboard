server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # DNS resolver for service discovery
    # Uses NGINX_DNS_RESOLVER env var, defaults to 8.8.8.8 for external services
    # For Kubernetes: set to kube-dns ClusterIP (typically 10.96.0.10)
    resolver ${NGINX_DNS_RESOLVER} valid=30s ipv6=off;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Health check endpoint
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # SPA routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy for HSY WFS (avoids CORS in production)
    location /hsy-wfs/ {
        proxy_pass https://kartta.hsy.fi/;
        proxy_set_header Host kartta.hsy.fi;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # Reverse proxy for Helsinki WFS (avoids CORS in production)
    location /hel-wfs/ {
        proxy_pass https://kartta.hel.fi/;
        proxy_set_header Host kartta.hel.fi;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # Reverse proxy for InfluxDB (hides token server-side)
    location /influxdb-api/ {
        # Store the host in a variable first
        set $influxdb_host "${INFLUXDB_HOST}";

        # Derive protocol based on host type:
        # - Use http for localhost development (localhost:port)
        # - Use http for internal Kubernetes services (short names without dots, or *.svc.cluster.local)
        # - Use https for external services (*.dataportal.fi, etc.)
        set $influxdb_protocol "https";
        if ($influxdb_host ~* "^localhost:[0-9]+$") {
            set $influxdb_protocol "http";
        }
        if ($influxdb_host ~* "\.svc\.cluster\.local$") {
            set $influxdb_protocol "http";
        }
        # Short K8s service names (no dots) are internal services using HTTP
        if ($influxdb_host ~* "^[^.:]+:[0-9]+$") {
            set $influxdb_protocol "http";
        }

        # Rewrite to strip /influxdb-api prefix
        rewrite ^/influxdb-api/(.*)$ /$1 break;

        # Proxy to InfluxDB with authentication
        proxy_pass $influxdb_protocol://$influxdb_host;
        proxy_set_header Host $influxdb_host;
        proxy_set_header Authorization "Token ${INFLUXDB_TOKEN}";
        proxy_ssl_server_name on;
        proxy_ssl_verify off;

        # Timeouts for potentially long-running queries
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Don't cache InfluxDB queries
        proxy_buffering off;
        proxy_cache_bypass 1;
        proxy_no_cache 1;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
