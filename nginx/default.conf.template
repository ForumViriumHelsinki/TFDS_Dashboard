server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Health check endpoint
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # SPA routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy for HSY WFS (avoids CORS in production)
    location /hsy-wfs/ {
        proxy_pass https://kartta.hsy.fi/;
        proxy_set_header Host kartta.hsy.fi;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # Reverse proxy for Helsinki WFS (avoids CORS in production)
    location /hel-wfs/ {
        proxy_pass https://kartta.hel.fi/;
        proxy_set_header Host kartta.hel.fi;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # Reverse proxy for InfluxDB (hides token server-side)
    # Note: We use static URLs (substituted by envsubst at startup) rather than NGINX
    # variables with a resolver directive. This ensures DNS resolution happens at config
    # load time using the pod's /etc/resolv.conf, avoiding the need for cluster-specific
    # DNS resolver IPs that vary between Kubernetes distributions.
    location /influxdb-api/ {
        rewrite ^/influxdb-api/(.*)$ /$1 break;

        # Proxy to InfluxDB with authentication
        # Use http:// for internal K8s services (HTTPS terminated at the gateway)
        proxy_pass ${INFLUXDB_URL};
        proxy_set_header Host ${INFLUXDB_HOST};
        proxy_set_header Authorization "Token ${INFLUXDB_TOKEN}";

        # Timeouts for potentially long-running queries
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Don't cache InfluxDB queries
        proxy_buffering off;
        proxy_cache_bypass 1;
        proxy_no_cache 1;
    }

    # GO Feature Flag relay proxy
    location /feature-flags/ {
        proxy_pass http://gofeatureflag.feature-flags.svc.cluster.local:1031/;
        proxy_set_header Host gofeatureflag.feature-flags.svc.cluster.local;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        proxy_cache off;
        add_header Cache-Control "no-cache, no-store" always;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
